{
  "type": "record",
  "name": "PaymentEvent",
  "namespace": "com.example.events",
  "doc": "Event representing payment-related actions in the system",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Unique identifier for this event"
    },
    {
      "name": "paymentId",
      "type": "string",
      "doc": "Identifier of the payment this event relates to"
    },
    {
      "name": "orderId",
      "type": "string",
      "doc": "Identifier of the order associated with this payment"
    },
    {
      "name": "eventType",
      "type": "string",
      "doc": "Type of the event (e.g., PaymentStarted, PaymentCompleted, PaymentFailed)"
    },
    {
      "name": "timestamp",
      "type": "long",
      "logicalType": "timestamp-millis",
      "doc": "When the event occurred"
    },
    {
      "name": "amount",
      "type": "double",
      "doc": "Payment amount"
    },
    {
      "name": "currency",
      "type": "string",
      "default": "USD",
      "doc": "Currency code for the payment"
    },
    {
      "name": "payload",
      "type": "string",
      "doc": "JSON payload containing event-specific data"
    },
    {
      "name": "version",
      "type": "int",
      "default": 1,
      "doc": "Schema version for backward compatibility"
    }
  ]
}