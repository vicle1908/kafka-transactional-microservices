{
  "namespace": "com.example.events.avro",
  "type": "record",
  "name": "OrderCreatedEvent",
  "doc": "Canonical Avro representation of an order creation event emitted through the transactional outbox.",
  "fields": [
    { "name": "event_id", "type": {"type": "string", "logicalType": "uuid"} },
    { "name": "aggregate_id", "type": {"type": "string", "logicalType": "uuid"} },
    { "name": "occurred_at", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "payload", "type": "string" },
    { "name": "headers", "type": ["null", {"type": "map", "values": "string"}], "default": null }
  ]
}
