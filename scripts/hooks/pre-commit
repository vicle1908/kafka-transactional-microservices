#!/bin/bash
# Pre-commit hook for code quality checks
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or run: ./scripts/install-hooks.sh

set -e

echo "🔍 Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track if we need to re-stage files after auto-fix
RESTAGE_NEEDED=false

# Get list of staged files
STAGED_KOTLIN_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.kt$' || true)
STAGED_MD_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)
STAGED_YAML_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(yml|yaml)$' || true)

# Function to check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# ============================================
# 1. ktlint format (auto-fix) for staged Kotlin files only
# ============================================
if [ -n "$STAGED_KOTLIN_FILES" ]; then
    echo -e "${YELLOW}📝 Running ktlint format on staged files...${NC}"
    
    # Create a temporary file list for ktlint
    KTLINT_FILES=""
    for file in $STAGED_KOTLIN_FILES; do
        if [ -f "$file" ]; then
            KTLINT_FILES="$KTLINT_FILES $file"
        fi
    done
    
    if [ -n "$KTLINT_FILES" ]; then
        # Run ktlint format on specific files using ktlint CLI directly if available
        # Otherwise fall back to gradle (slower)
        if command_exists ktlint; then
            # shellcheck disable=SC2086
            if ktlint --format $KTLINT_FILES 2>/dev/null; then
                echo -e "${GREEN}✅ ktlint format complete${NC}"
                RESTAGE_NEEDED=true
            fi
            # shellcheck disable=SC2086
            if ktlint $KTLINT_FILES 2>/dev/null; then
                echo -e "${GREEN}✅ ktlint check passed${NC}"
            else
                echo -e "${RED}❌ ktlint check failed. Please fix the issues above.${NC}"
                exit 1
            fi
        else
            # Fallback: Use gradle ktlintFormat (slower but reliable)
            echo -e "${YELLOW}⚠️  ktlint CLI not found. Using Gradle ktlintFormat...${NC}"
            if ./gradlew ktlintFormat --no-daemon -q 2>/dev/null; then
                echo -e "${GREEN}✅ ktlint format complete${NC}"
                RESTAGE_NEEDED=true
            else
                echo -e "${RED}❌ ktlint format failed${NC}"
                exit 1
            fi
        fi
    fi
fi

# ============================================
# 2. markdownlint-cli2 (auto-fix) for Markdown files
# ============================================
if [ -n "$STAGED_MD_FILES" ]; then
    if command_exists npx; then
        echo -e "${YELLOW}📝 Running markdownlint-cli2 (auto-fix)...${NC}"
        # shellcheck disable=SC2086
        if npx markdownlint-cli2 --fix $STAGED_MD_FILES 2>/dev/null; then
            echo -e "${GREEN}✅ markdownlint-cli2 complete${NC}"
            RESTAGE_NEEDED=true
        else
            echo -e "${RED}❌ markdownlint-cli2 found unfixable issues${NC}"
            exit 1
        fi
    else
        echo -e "${YELLOW}⚠️  npx not found, skipping markdownlint${NC}"
    fi
fi

# ============================================
# 3. yamllint for YAML files
# ============================================
if [ -n "$STAGED_YAML_FILES" ]; then
    if command_exists yamllint; then
        echo -e "${YELLOW}🔍 Running yamllint...${NC}"
        # shellcheck disable=SC2086
        if yamllint -c .yamllint $STAGED_YAML_FILES 2>/dev/null; then
            echo -e "${GREEN}✅ yamllint passed${NC}"
        else
            echo -e "${RED}❌ yamllint found issues. Please fix them.${NC}"
            exit 1
        fi
    else
        echo -e "${YELLOW}⚠️  yamllint not found, skipping YAML lint${NC}"
    fi
fi

# ============================================
# 4. Detekt static analysis for staged Kotlin files
# ============================================
if [ -n "$STAGED_KOTLIN_FILES" ]; then
    echo -e "${YELLOW}🔍 Running detekt on staged Kotlin files...${NC}"
    
    # Use detektChanged task which only analyzes staged files (fast)
    if ./gradlew detektChanged --no-daemon --no-configuration-cache -q 2>&1; then
        echo -e "${GREEN}✅ detekt passed${NC}"
    else
        echo -e "${RED}❌ detekt found issues. Please fix them before committing.${NC}"
        echo -e "${YELLOW}ℹ️  Run './gradlew detektAll --no-configuration-cache' for full report${NC}"
        exit 1
    fi
fi

# ============================================
# 5. Re-stage auto-fixed files
# ============================================
if [ "$RESTAGE_NEEDED" = true ]; then
    echo -e "${YELLOW}📦 Re-staging auto-fixed files...${NC}"
    if [ -n "$STAGED_KOTLIN_FILES" ]; then
        for file in $STAGED_KOTLIN_FILES; do
            if [ -f "$file" ]; then
                git add "$file" 2>/dev/null || true
            fi
        done
    fi
    if [ -n "$STAGED_MD_FILES" ]; then
        for file in $STAGED_MD_FILES; do
            if [ -f "$file" ]; then
                git add "$file" 2>/dev/null || true
            fi
        done
    fi
    echo -e "${GREEN}✅ Files re-staged${NC}"
fi

echo -e "${GREEN}🎉 Pre-commit checks passed!${NC}"
exit 0
