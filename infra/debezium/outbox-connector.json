{
  "retired": true,
  "name": "orders-outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "slot.name": "orders_outbox_slot",
    "plugin.name": "pgoutput",
    "publication.autocreate.mode": "filtered",
    "tombstones.on.delete": "false",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "app",
    "database.password": "app",
    "database.dbname": "orders",
    "database.server.name": "orders",
    "table.include.list": "public.outbox",
    "topic.prefix": "orders",
    "key.converter": "io.debezium.converters.spi.BinaryDataConverter",
    "key.converter.delegate.converter.class": "io.confluent.connect.avro.AvroConverter",
    "key.converter.delegate.converter.schema.registry.url": "http://schema-registry:8081",
    "value.converter": "io.debezium.converters.spi.BinaryDataConverter",
    "value.converter.delegate.converter.class": "io.confluent.connect.avro.AvroConverter",
    "value.converter.delegate.converter.schema.registry.url": "http://schema-registry:8081",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.route.by.field": "aggregateType",
    "transforms.outbox.route.topic.replacement": "${routedByValue}",
    "transforms.outbox.table.fields.additional.placement": "headers:header,aggregateId:header",
    "transforms.outbox.table.field.event.key": "aggregateId",
    "poll.interval.ms": "1000",
    "slot.drop.on.stop": "false"
  }
}
